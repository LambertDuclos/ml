#!/usr/bin/env bash
# ml: the gestures of the learning repo (CLAUDE.md, "The session").
#   ml session [words…]   opens today's sitting with the tutor; the words follow "Open the session."
#   ml tests [args…]      uv run pytest, the whole repo or what you give it
# The tutor is launched like equipe's engineer: --effort on the command line (under --agent, the
# header's effort field does not apply to the main session), --permission-mode auto, --autocompact
# 300k. ML_SESSION=1 closes the method to the tutor (CLAUDE.md, "Changing the method").
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  sed -n '2,4p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  session)
    shift
    cd "$root"
    export ML_SESSION=1
    exec claude --agent tutor --effort xhigh \
      --settings .claude/tutor.settings.json --permission-mode auto \
      --name "ml-$(date +%F)" --autocompact 300k \
      "Open the session. $*"
    ;;
  tests)
    shift
    cd "$root"
    exec uv run pytest "$@"
    ;;
  -h|--help|"")
    usage
    ;;
  *)
    echo "ml: unknown gesture '$1'" >&2
    usage >&2
    exit 64
    ;;
esac
